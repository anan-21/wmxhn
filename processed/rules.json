{
  "rules": [
    {
      "id": "family_poor",
      "description": "家庭条件不好（没矿）",
      "condition": "user.family_wealth <= 4",
      "effects": {
        "weight_stability": 1.8,
        "weight_salary": 1.5,
        "weight_interest": -0.5,
        "weight_risk": -1.0
      },
      "note": "先谋生再谋爱，薪资和稳定必须拉满，风险偏好降到最低"
    },
    {
      "id": "family_rich",
      "description": "家庭条件好（有矿）",
      "condition": "user.family_wealth >= 8",
      "effects": {
        "weight_interest": 1.8,
        "weight_salary": 0.6,
        "weight_stability": 0.6,
        "weight_risk": 0.0
      },
      "note": "有试错成本，可以优先考虑兴趣和梦想，不必被就业绑架"
    },
    {
      "id": "subject_science",
      "description": "理科生选专业",
      "condition": "user.subject === 'science'",
      "effects": {
        "weight_major_match": 2.0,
        "weight_school_level": 0.3
      },
      "note": "理工科：专业壁垒决定就业，学校名气相对次要"
    },
    {
      "id": "subject_arts",
      "description": "文科生选学校",
      "condition": "user.subject === 'arts'",
      "effects": {
        "weight_school_level": 2.0,
        "weight_major_match": 0.3
      },
      "note": "文科：平台和圈子决定起点，学校层次远比专业细分重要"
    },
    {
      "id": "ai_high_risk",
      "description": "AI替代风险高（如基础编程、翻译）",
      "condition": "major.ai_replace_risk === 'high'",
      "effects": {
        "weight_stability": -1.5,
        "weight_salary": -0.8
      },
      "note": "AI能替代的低端岗位，未来的稳定性和薪资预期必须打折"
    },
    {
      "id": "ai_low_risk",
      "description": "AI替代风险低（如临床、电气、建筑）",
      "condition": "major.ai_replace_risk === 'low'",
      "effects": {
        "weight_stability": 1.5,
        "weight_salary": 0.5
      },
      "note": "需要现场操作/复杂决策的岗位，AI暂时够不着，护城河加深"
    },
    {
      "id": "finance_bg_check",
      "description": "金融专业背景审查",
      "condition": "major.id === 'finance' && user.family_finance_bg === false",
      "effects": {
        "weight_salary": -2.0,
        "weight_stability": -3.0
      },
      "note": "家里没搞金融的，千万别碰！90%的人毕业去银行网点卖理财"
    },
    {
      "id": "unclear_interest",
      "description": "学生没有明确兴趣方向",
      "condition": "user.interest_clarity === false",
      "effects": {
        "weight_就业导向": 2.5,
        "weight_interest": -1.0
      },
      "note": "没想法就选最宽口径、最好找工作的专业，别谈理想先谈生存"
    },
    {
      "id": "want_big_city",
      "description": "优先去大城市发展",
      "condition": "user.prefers_big_city === true",
      "effects": {
        "weight_city_opportunity": 2.0
      },
      "note": "城市决定思维、资源和机会差距，能去北上广杭苏就别去三四线"
    },
    {
      "id": "fortune500_test_fail",
      "description": "500强不去该校/该专业招聘",
      "condition": "major.fortune500_recruit === false",
      "effects": {
        "weight_salary": -1.5
      },
      "note": "如果头部企业都不来招，说明这个专业/学校的市场认可度极低"
    }
  ]
}
